{
  "name": "koin",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --parallel --filter @koin/web --filter @koin/api dev",
    "dev:web": "pnpm --filter @koin/web dev",
    "dev:api": "pnpm --filter @koin/api dev",
    "dev:b-bot": "pnpm --filter @koin/b-bot dev",
    "deploy:b-bot": "pnpm --filter @koin/b-bot run deploy",
    "deploy:api": "pnpm --filter @koin/api run deploy",
    "deploy:api:preview": "pnpm --filter @koin/api run deploy:preview",
    "deploy:error-automation": "pnpm --filter @koin/error-automation run deploy",
    "deploy:error-automation:preview": "pnpm --filter @koin/error-automation run deploy:preview",
    "preview": "pnpm --filter @koin/web preview",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm lint:oxlint && pnpm --filter @koin/web lint",
    "lint:oxlint": "oxlint apps scripts --deny-warnings",
    "test": "pnpm -r --if-present test && node --test scripts/autofix/security.test.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@sentry/cli": "^3.8.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "4.155.0"
  },
  "engines": {
    "node": "24.22.1",
    "pnpm": "12.16.1"
  },
  "packageManager": "pnpm@12.16.1"
}
