{
  "name": "koin",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --parallel --filter @koin/web --filter @koin/api dev",
    "dev:web": "pnpm --filter @koin/web dev",
    "dev:api": "pnpm --filter @koin/api dev",
    "dev:b-bot": "pnpm --filter @koin/b-bot dev",
    "deploy:b-bot": "pnpm --filter @koin/b-bot run deploy",
    "deploy:api": "pnpm --filter @koin/api run deploy",
    "deploy:api:preview": "pnpm --filter @koin/api run deploy:preview",
    "deploy:error-automation": "pnpm --filter @koin/error-automation run deploy",
    "deploy:error-automation:preview": "pnpm --filter @koin/error-automation run deploy:preview",
    "preview": "pnpm --filter @koin/web preview",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm lint:oxlint && pnpm --filter @koin/web lint",
    "lint:oxlint": "oxlint apps scripts --deny-warnings",
    "test": "pnpm -r --if-present test && node --test scripts/autofix/security.test.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@sentry/cli": "^3.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": "24.22.1",
    "pnpm": "10.32.1"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "tar": "7.5.21",
      "brace-expansion@^1.1.7": "1.1.16",
      "brace-expansion@^2.0.1": "2.1.2",
      "brace-expansion@^5.0.2": "5.0.9",
      "js-yaml@^3.13.1": "3.15.0",
      "js-yaml@^4.1.0": "4.3.0",
      "immutable": "4.3.9",
      "picomatch@^4.0.2": "4.0.5",
      "picomatch@^4.0.3": "4.0.5",
      "minimatch@^9.0.1": "9.0.9",
      "minimatch@^9.0.4": "9.0.9",
      "glob@^10.2.2": "10.5.0",
      "glob@^10.3.7": "10.5.0",
      "glob@^10.3.10": "10.5.0",
      "postcss@^8.5.6": "8.5.26",
      "postcss@^8.5.15": "8.5.26",
      "form-data": "4.0.6",
      "uuid": "11.1.1",
      "svgo": "3.3.4",
      "ip": "2.0.1",
      "@babel/core": "7.29.6",
      "@opentelemetry/core": "2.11.0"
    }
  }
}
