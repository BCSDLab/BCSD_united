{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bcsd-error-automation",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
  "durable_objects": {
    "bindings": [
      { "name": "ERROR_ISSUES", "class_name": "ErrorIssueDispatch" },
      { "name": "AUTOFIX_QUEUE", "class_name": "AutofixQueue" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ErrorIssueDispatch"] },
    { "tag": "v2", "new_sqlite_classes": ["AutofixQueue"] },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ENVIRONMENT": "production",
    "SENTRY_ORGANIZATION": "bcsd",
    "SENTRY_PROJECT_APPS": "{\"koin-united-prod\":\"web\",\"koin-united-preview\":\"web\"}",
    "SENTRY_PROJECT_HOSTS": "{\"koin-united-prod\":[\"koreatech.in\"],\"koin-united-preview\":[\"stage.koreatech.in\"]}",
    "ERROR_PROJECT_DOMAINS": "{\"sentry:koin-united-prod\":\"공통\",\"sentry:koin-united-preview\":\"공통\"}",
    "CLOUDFLARE_SOURCES": "[]",
    "AUTOFIX_EXECUTOR_ID": "koin-rocky-umpc",
    "GITHUB_OWNER": "BCSDLab",
    "GITHUB_REPOSITORY": "BCSD_united",
    "GITHUB_DISPATCH_APP_ID": "5522353",
    "GITHUB_DISPATCH_INSTALLATION_ID": "176455083",
  },
}
