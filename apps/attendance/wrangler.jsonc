{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bcsd-attendance",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // id는 첫 배포 때 wrangler가 네임스페이스를 만들고 기록합니다.
  "kv_namespaces": [{ "binding": "ATTENDANCE" }],
}
