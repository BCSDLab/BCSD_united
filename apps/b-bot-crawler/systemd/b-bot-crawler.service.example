[Unit]
Description=B_BOT document crawler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bbot
Group=bbot
WorkingDirectory=/opt/bcsd-bbot-pi/apps/b-bot-crawler
UMask=0077
EnvironmentFile=/etc/b-bot-crawler.env
ExecStart=/usr/bin/env pnpm start
Restart=on-failure
RestartSec=10
# Indexing can take hours. SIGTERM marks the active job interrupted; the process
# waits for its in-flight ingestion to settle and closes its PostgreSQL pool.
TimeoutStopSec=21600
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/b-bot-crawler

[Install]
WantedBy=multi-user.target
