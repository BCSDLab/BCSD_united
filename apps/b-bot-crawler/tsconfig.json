{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "~/*": ["../b-bot/src/*"],
      "@/*": ["../b-bot/src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
