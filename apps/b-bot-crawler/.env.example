# Copy values into a root-readable EnvironmentFile, not this tracked template.
CRAWLER_STATE_PATH=/var/lib/b-bot-crawler/jobs.sqlite
CRAWLER_PORT=8813
# Generate a random secret >=32 characters. Store the same value in the Worker secret.
CRAWLER_AUTH_TOKEN=
# PostgreSQL connection reachable from the Raspberry Pi (or DB_HOST/DB_USER/DB_PASSWORD/DB_NAME).
DATABASE_URL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
NOTION_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: restrict Drive crawling to these folder IDs; absence means all accessible Docs.
GDRIVE_FOLDER_IDS=
