{
  "name": "@koin/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "tsx --tsconfig tsconfig.json --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\" && node --test \"scripts/*.test.mjs\"",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler preview"
  },
  "dependencies": {
    "@hono/swagger-ui": "0.6.2",
    "@koin/telemetry": "workspace:*",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "hono": "4.13.14",
    "parse5": "8.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "0.31.11",
    "mysql2": "3.24.6"
  }
}
