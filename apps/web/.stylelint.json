{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "selector-class-pattern": [
      "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z][a-z0-9]*(-[a-z0-9]+)*)?(--[a-z][a-z0-9]*(-[a-z0-9]+)*)?$",
      {
        "message": "BEM kebab-case: block__element--modifier"
      }
    ],
    "declaration-block-no-shorthand-property-overrides": true,
    "function-no-unknown": true,
    "no-unknown-animations": true
  },
  "overrides": [
    {
      "files": ["src/components/ui/**/*.scss"],
      "rules": {
        "color-no-hex": [
          true,
          {
            "message": "hex 색을 직접 쓰지 말고 src/utils/scss/tokens의 토큰을 쓰세요(@use \"src/utils/scss/tokens\" as tokens;). 맞는 토큰이 없으면 같은 변경에서 tokens.scss에 추가하세요."
          }
        ]
      }
    }
  ]
}
