[Unit]
Description=KOIN autofix omp gateway tunnel (koin-omp-gateway.koreatech.in -> 127.0.0.1:43129)
Wants=network-online.target koin-omp-gateway.service
After=network-online.target koin-omp-gateway.service

[Service]
Type=simple
DynamicUser=yes
# Remotely managed tunnel `koin-omp-gateway-rocky`; its ingress lives in the Cloudflare dashboard.
LoadCredential=token:/etc/koin-autofix/omp-tunnel.token
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token-file ${CREDENTIALS_DIRECTORY}/token
NoNewPrivileges=yes
Restart=always
RestartSec=5s
TimeoutStopSec=20s
MemoryMax=256M

[Install]
WantedBy=multi-user.target
