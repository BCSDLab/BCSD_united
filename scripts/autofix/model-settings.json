{
  "permissions": {
    "defaultMode": "default",
    "allow": ["Read", "Edit", "Write", "Glob", "Grep"],
    "deny": ["Bash", "Agent", "Task", "WebFetch", "WebSearch", "NotebookEdit", "mcp__*"]
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "node scripts/autofix/tool-policy.mjs", "timeout": 10 }]
      }
    ]
  },
  "sandbox": { "enabled": true, "autoAllowBashIfSandboxed": false, "allowUnsandboxedCommands": false }
}
