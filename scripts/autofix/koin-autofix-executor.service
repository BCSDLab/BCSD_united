[Unit]
Description=KOIN error-autofix executor (dedicated Rocky UMPC)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
# The Docker socket is root-equivalent and belongs ONLY to this trusted control container.
# Model file tools and verifier child containers never receive the socket or the env file.
ExecStartPre=/usr/local/libexec/koin-autofix-cleanup
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/koin-autofix/jobs /var/lib/koin-autofix/state /var/lib/koin-autofix/cache
ExecStart=/usr/bin/docker run --rm --name koin-autofix-executor --network bridge --cpus 1 --memory 2g --pids-limit 256 --cap-drop ALL --security-opt no-new-privileges --read-only --tmpfs /tmp:rw,nosuid,nodev,size=128m --mount type=bind,src=/var/lib/koin-autofix/jobs,dst=/var/lib/koin-autofix/jobs --mount type=bind,src=/var/lib/koin-autofix/state,dst=/var/lib/koin-autofix/state --mount type=bind,src=/var/lib/koin-autofix/cache,dst=/var/lib/koin-autofix/cache --mount type=bind,src=/var/run/docker.sock,dst=/var/run/docker.sock --env-file /etc/koin-autofix/executor.env koin-autofix-executor
ExecStop=/usr/bin/docker stop --time 30 koin-autofix-executor
ExecStopPost=/usr/local/libexec/koin-autofix-cleanup
Restart=on-failure
RestartSec=30s
TimeoutStopSec=45s

[Install]
WantedBy=multi-user.target
